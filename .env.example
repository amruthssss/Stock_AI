# Copy to .env and set local-only values. Never commit .env.
POSTGRES_DB=stockwise
POSTGRES_USER=stockwise
POSTGRES_PASSWORD=replace-with-a-local-password

# Native Windows development uses 127.0.0.1. Docker Compose overrides this
# internally to use the postgres service name.
STOCKWISE_DATABASE_URL=postgresql+psycopg://stockwise:replace-with-a-local-password@127.0.0.1:5432/stockwise

# Optional local AI explanation.
STOCKWISE_LLM_ENABLED=false
# Native Windows: http://127.0.0.1:11434. Docker Compose defaults to
# http://host.docker.internal:11434 unless this variable is explicitly set.
STOCKWISE_OLLAMA_BASE_URL=http://127.0.0.1:11434
STOCKWISE_OLLAMA_MODEL=
STOCKWISE_LLM_TIMEOUT_SECONDS=120
STOCKWISE_AGENT_EXECUTION_MODE=sequential

# Required only for the local approval-write API.
STOCKWISE_APPROVAL_ADMIN_TOKEN=
STOCKWISE_INTEGRATION_API_KEY=
STOCKWISE_INTEGRATION_RATE_LIMIT_PER_MINUTE=60

# Safe local email defaults; Mailpit uses the internal Docker hostname.
STOCKWISE_EMAIL_MODE=dry_run
STOCKWISE_EMAIL_SMTP_HOST=127.0.0.1
STOCKWISE_EMAIL_SMTP_PORT=1025
STOCKWISE_EMAIL_FROM=stockwise@localhost
STOCKWISE_EMAIL_ALLOWED_RECIPIENTS=
STOCKWISE_EMAIL_TIMEOUT_SECONDS=5
